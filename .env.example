# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Firebase Admin — UNE des options suivantes :

# Option A (recommandé Railway) : JSON téléchargé depuis Firebase, encodé en base64 sur une seule ligne
#   macOS/Linux : base64 -i serviceAccountKey.json | tr -d '\n'
#   Puis coller le résultat dans Railway → Variable FIREBASE_SERVICE_ACCOUNT_BASE64
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Option B : JSON complet sur une ligne (échapper les guillemets si besoin)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Option B2 : fichier JSON local (pratique en dev, ne pas utiliser sur Railway)
# FIREBASE_SERVICE_ACCOUNT_PATH=./fit-scan-ai-firebase-adminsdk-xxxx.json

# Option C : trois variables (souvent fragile sur Railway à cause des \n dans la clé)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optionnel — port HTTP (défaut: 3000)
# PORT=3000

# Optionnel — CORS
# CORS_ORIGIN=https://example.com

# Offres promotionnelles StoreKit (feuille Apple au prix réduit).
# Clé « In-App Purchase » App Store Connect (Users and Access → Integrations → In-App Purchase).
# APP_STORE_BUNDLE_ID=app.noraxai.norax
# APP_STORE_IAP_KEY_ID=
# APP_STORE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
